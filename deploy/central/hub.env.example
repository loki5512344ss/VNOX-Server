# Install a completed copy as /etc/vnox-central/hub.env, root:root mode 0600.
# This is an example, never add production secrets to Git.
HUB_BIND=127.0.0.1:37623
HUB_DATA_DIR=/var/lib/vnox-central
PUBLIC_BASE_URL=https://central.loki-code.dev
SMTP_HOST=smtp.provider.example
SMTP_PORT=587
SMTP_USER=replace-on-server
SMTP_PASSWORD=replace-on-server
MAIL_FROM="Vnox <noreply@loki-code.dev>"
RUST_LOG=vnox_hub=info

# Optional GitHub App / OAuth App user sign-in. Configure both or neither.
# GITHUB_CLIENT_ID=your-public-client-id
# GITHUB_CLIENT_SECRET=your-secret
